Total Customers = DISTINCTCOUNT(customer_churn[customer_id])
Churned Customers = CALCULATE([Total Customers], customer_churn[churned] = "Yes")
Retained Customers = CALCULATE([Total Customers], customer_churn[churned] = "No")
Churn Rate % = DIVIDE([Churned Customers], [Total Customers])
Retention Rate % = DIVIDE([Retained Customers], [Total Customers])
Monthly Charges INR = SUM(customer_churn[monthly_charges_inr])
Monthly Charges Associated with Churn INR = CALCULATE([Monthly Charges INR], customer_churn[churned] = "Yes")
Average Monthly Charge INR = AVERAGE(customer_churn[monthly_charges_inr])
Average Tenure Months = AVERAGE(customer_churn[tenure_months])
Average Support Tickets = AVERAGE(customer_churn[support_tickets_90d])
